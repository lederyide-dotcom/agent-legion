# 由 src/legion/diagrams.py 產生；請改程式，不要手改此檔。
filters:
  and:
  - file.inFolder("AI/tasks")
  - file.ext == "md"
formulas:
  state_label: if(state == "DONE", "✅ 完成", if(state == "HALT", "⛔ 熔斷", if(state == "WAIT_HUMAN", "✋ 等你", "⏳ " + state)))
  risk_label: if(risk == "high", "🔴 高", if(risk == "mid", "🟡 中", if(risk == "low", "🟢 低", "")))
  cost_label: if(cost_usd, "$" + cost_usd.toFixed(4), "")
properties:
  file.name:
    displayName: 任務
  title:
    displayName: 標題
  state:
    displayName: 狀態代碼
  risk:
    displayName: 風險代碼
  cost_usd:
    displayName: 成本 USD
  human_touches:
    displayName: 人工介入
  verdict:
    displayName: 審查結論
  wait_reason:
    displayName: 等待原因
  halt_reason:
    displayName: 熔斷原因
  formula.state_label:
    displayName: 狀態
  formula.risk_label:
    displayName: 風險
  formula.cost_label:
    displayName: 成本
views:
- type: table
  name: 依狀態
  groupBy:
    property: state
    direction: ASC
  order:
  - file.name
  - title
  - formula.state_label
  - formula.risk_label
  - formula.cost_label
  - human_touches
  - verdict
  summaries:
    cost_usd: Sum
    human_touches: Sum
- type: table
  name: 依風險
  groupBy:
    property: risk
    direction: DESC
  order:
  - file.name
  - title
  - formula.risk_label
  - formula.state_label
  - cost_usd
  summaries:
    cost_usd: Sum
- type: table
  name: 等待使用者
  filters:
    or:
    - state == "WAIT_HUMAN"
    - state == "HALT"
  order:
  - file.name
  - title
  - formula.state_label
  - wait_reason
  - halt_reason
