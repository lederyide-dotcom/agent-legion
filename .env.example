# agent-legion 環境設定範例。全部都有預設值，只在需要覆寫時設定。
# 複製成 .env 後由你的 shell 或啟動腳本載入；.env 已在 .gitignore，不會進版控。

# --- 資料庫（Docker 內的 PostgreSQL，只綁 127.0.0.1）
LEGION_DB_USER=legion
LEGION_DB_PASSWORD=change_me_local_only
LEGION_DB_NAME=legion
LEGION_DB_PORT=55432
LEGION_SCHEMA=legion

# --- 目錄（預設皆為專案根目錄下的相對路徑）
# LEGION_VAULT=./vault
# LEGION_DATA_DIR=./02_data
# LEGION_OUTPUT_DIR=./01_output
# LEGION_WORKTREES=./.worktrees

# --- agent
LEGION_BACKEND=claude
# 設定後所有角色統一用這個模型、不升級；平常留空，改用下面的角色表
# LEGION_MODEL=sonnet
# 逐角色覆寫（角色：PLANNER、SPEC_REVIEWER、EXECUTOR、REVIEWER、SCRIBE、ADVISOR、STRATEGIST；effort 可設 none）
# LEGION_MODEL_PLANNER=opus
# LEGION_EFFORT_PLANNER=medium
# LEGION_MODEL_SCRIBE=claude-haiku-5-5
# 需求釐清：想法不清楚時規劃者先提問（附預設答案）；設 0 關閉。使用者閒置幾分鐘後採用預設答案
# LEGION_CLARIFY=1
# LEGION_CLARIFY_IDLE_MINUTES=15
# legion idea 沒給 --repo、也不在 git repo 裡時的目標 repo
# LEGION_DEFAULT_REPO=
# 軍師：任務卡住時提出錦囊；設 0 關閉。使用者閒置幾分鐘後由指揮官＋軍師自動決議
# LEGION_ADVISOR=1
# LEGION_ADVISOR_IDLE_MINUTES=15
# LEGION_MODEL_ADVISOR=opus
# LEGION_EFFORT_ADVISOR=high
# 執行者重做時的升級模型；設 off 關閉升級
# LEGION_ESCALATE_MODEL=opus
# LEGION_ESCALATE_EFFORT=high

# --- 外部工具（未設定時自動偵測：先找 PATH，再找常見安裝位置）
# LEGION_SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe
# LEGION_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# LEGION_RENDER_MERMAID=1
# mmdc 路徑（預設 tools\mermaid\node_modules\.bin\mmdc.cmd；git worktree 內沒有 node_modules 時指回主目錄）
# LEGION_MERMAID_CLI=
# 終端輸出轉圖字型（預設 %WINDIR%\Fonts 下的 consola.ttf／msjh.ttc）
# LEGION_FONT_MONO=
# LEGION_FONT_CJK=
